APP_NAME="Casino Gecce"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Promex protected-service endpoints. Production defaults require no changes.
PROMEX_HUB_URL=https://clients.377.live/api/service
PROMEX_CEDAR_PUBLIC_ORIGIN=https://clients.377.live
PROMEX_HUB_VERSION_URL=https://clients.377.live/api/service/version
PROMEX_MYSQLDUMP_BINARY=mysqldump
PROMEX_HUB_TIMEOUT=8
PROMEX_AUTO_ACTIVATE=true
PROMEX_RUNTIME_PROFILE=live
# Development only: accepted only when APP_ENV=local. Never ship a local key.
PROMEX_LOCAL_PUBLIC_KEY_FILE=
PROMEX_LOCAL_CA_FILE=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=bulk.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@demomailtrap.co"
MAIL_FROM_NAME="${APP_NAME}"

# Mailtrap Email API (use MAIL_MAILER=mailtrap to send over HTTPS instead of SMTP).
# Requires a verified sending domain (Mailtrap -> Sending Domains).
MAILTRAP_API_TOKEN=
MAILTRAP_API_URL=https://send.api.mailtrap.io

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Admin Phone Number for Auto-Elevation / Setup
ADMIN_PHONE=+10000000000

# Production delivery. Development OTP preview must be explicitly enabled in backend.
WHATSAPP_MODE=promex
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Sportsbook Odds Provider
SPORTSBOOK_PROVIDER=the_odds_api
THE_ODDS_API_KEY=

# Casino aggregator (seamless wallet) — see config/casino_providers.php
# Callback: {CASINO_CALLBACK_BASE}/webhooks/aggregator/{CASINO_CALLBACK_SLUG}/wallet
# Register this URL with the aggregator's integration manager.
CASINO_CALLBACK_BASE="${APP_URL}"
CASINO_CALLBACK_SLUG=
CASINO_WALLET_CURRENCY=TRY
CASINO_WALLET_USER_PREFIX=

# One block per provider; all four share the callback slug above.
PRAGMATIC_ENDPOINT=
PRAGMATIC_AGENT_ID=
PRAGMATIC_API_TOKEN=
PRAGMATIC_SECRET_KEY=

PGSOFT_ENDPOINT=
PGSOFT_AGENT_ID=
PGSOFT_API_TOKEN=
PGSOFT_SECRET_KEY=
# The aggregator returns PG Soft's phone build regardless of caller, so the
# embedded session is portrait. The lobby fits the player to this aspect; set
# "auto" only if a landscape build ever becomes available.
PGSOFT_EMBED_ASPECT=9:16

AMATIC_ENDPOINT=
AMATIC_AGENT_ID=
AMATIC_API_TOKEN=
AMATIC_SECRET_KEY=

AMUSNET_ENDPOINT=
AMUSNET_AGENT_ID=
AMUSNET_API_TOKEN=
AMUSNET_SECRET_KEY=

# smpl core (new aggregator). Merchant ID + Merchant Key are issued by the
# smpl core integration manager. The callback URL registered with them is
# <CASINO_CALLBACK_BASE>/webhooks/smplcore/callbacks.
SMPL_BASE_URL=https://staging.smplcore.net/api/index.php/v1
SMPL_MERCHANT_ID=
SMPL_MERCHANT_KEY=
SMPL_CURRENCY=TRY
SMPL_CALLBACK_PATH=/webhooks/smplcore/callbacks

# OroPlay aggregator (Live Casino, Slot & Mini Game API). clientId/clientSecret
# are issued per agent in the OroPlay agent page (staging ids look like
# "stg-TRY-<name>"). Outbound calls use a bearer token minted from these; the
# operator-side wallet callbacks are authenticated with HTTP Basic.
OROPLAY_BASE_URL=https://api.oroplay.com/api/v2
OROPLAY_CLIENT_ID=
OROPLAY_CLIENT_SECRET=
OROPLAY_CURRENCY=TRY
OROPLAY_CALLBACK_PATH=/webhooks/oroplay/api
OROPLAY_LOBBY_URL=

